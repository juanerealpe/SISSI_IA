<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<!-- Le indicamos al compilador que ignore el conflicto de degradación de paquetes NU1605 -->
	<NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>
  <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
	    <!-- Forzamos la versión exacta que exige tu ecosistema de .NET 10 -->
	    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0-*" />
	    <PackageReference Include="Microsoft.SemanticKernel.Core" Version="1.30.0" />
	    <PackageReference Include="Scalar.AspNetCore" Version="2.0.*" />
	    <PackageReference Include="Microsoft.SemanticKernel" Version="1.13.0" />
		<PackageReference Include="OpenAI" Version="2.1.0" />
		<PackageReference Include="System.ClientModel" Version="1.2.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SISSI_IA.Infrastructure\SISSI_IA.Infrastructure.csproj" />
  </ItemGroup>
</Project>